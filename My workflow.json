        "jsCode": "const aiContent = $json.choices[0].message.content;\nconst urgency = JSON.parse(aiContent).urgency.trim().toUpperCase();\n\n// Generate ticket ID\nconst ticketId = \"TICKET-\" + Date.now();\n\nlet action;\nlet routing;\n\nif (urgency === \"CRITICAL\") {\n  action = \"ESCALATE_IMMEDIATELY\";\n  routing = \"ENGINEERING\";\n} \nelse if (urgency === \"HIGH\") {\n  action = \"PRIORITY_INVESTIGATION\";\n  routing = \"SUPPORT\";\n} \nelse {\n  action = \"ADD_TO_QUEUE\";\n  routing = \"GENERAL_SUPPORT\";\n}\n\nreturn {\n  ticket_id: ticketId,\n  message: $json.body?.message ?? $json.message ?? \"\",\n  urgency: urgency,\n  action: action,\n  routing: routing,\n  timestamp: new Date().toISOString()\n};"
      },
